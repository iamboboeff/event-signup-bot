# --- Telegram ---
# Токен от @BotFather (вид: 1234567890:AAH...). НЕ коммитить.
BOT_TOKEN=

# ID группы для уведомлений о новых записях.
# Получишь так: создай группу, добавь бота, отправь в группе команду /id — бот пришлёт chat_id.
GROUP_CHAT_ID=

# Telegram user id администраторов (узнать через /id). Через запятую.
# Это рекомендуемый и самый надёжный способ выдать доступ.
ADMIN_IDS=

# Дополнительно можно разрешить username без @, через запятую.
ADMIN_USERNAMES=

# Полный публичный HTTPS-адрес веб-админки. Если WEBHOOK_URL задан,
# по умолчанию используется WEBHOOK_URL + /admin.
ADMIN_WEBAPP_URL=

# Папка постоянных данных (настройки и заявки). По умолчанию ./data.
DATA_DIR=

# --- Webhook (необязательно) ---
# Публичный URL сервиса (например https://bot.example.com).
# Если пусто — бот работает локально через long-polling.
WEBHOOK_URL=
# Секрет для проверки запросов от Telegram (необязательно; по умолчанию берётся из токена).
WEBHOOK_SECRET=

# --- Запись на диагностику через тестовую Google Таблицу ---
# URL развёрнутого Apps Script вида https://script.google.com/macros/s/.../exec
DOCTOR_SHEET_WEBAPP_URL=
# Общий секрет бота и Apps Script (не менее 16 случайных символов).
DOCTOR_SHEET_SECRET=

# --- Оплата СБП через Альфа-Банк (необязательно) ---
# Пока логин, пароль и ключ не заданы, платные заявки оплачиваются по реквизитам вручную.
# Адрес API: песочница по умолчанию; боевой — https://payment.alfabank.ru/payment/rest
ALFA_API_URL=
# Логин и пароль API-пользователя мерчанта (выдаёт банк). НЕ коммитить.
ALFA_USERNAME=
ALFA_PASSWORD=
# Ключ для проверки подписи callback-уведомлений (симметричный, HMAC-SHA256; выдаёт банк). НЕ коммитить.
ALFA_CALLBACK_SECRET=
